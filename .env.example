APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Partner courses API (confirmed against C:\Users\USER\Downloads\heirs
# app\Http\Controllers\Api\CourseApiController.php), called server-side
# only. Get the token by running:
#   php artisan api-clients:create "Fosterheirs Website"
# on THAT app's server, not this one.
COURSES_API_BASE_URL=
COURSES_API_TOKEN=
COURSES_API_TIMEOUT=15
COURSES_API_CACHE_TTL=300

# Confirmed route: routes/courses.php -> Route::get('/{course:slug}', ...)
# on the partner app, e.g. https://sojeanthonia.laravel.cloud/courses/{slug}
COURSES_STOREFRONT_URL_TEMPLATE=

# Same-origin now that this app serves both the views and the proxy, so
# CORS normally isn't exercised. Only matters if another site ever calls
# /api/public/* directly.
FRONTEND_ORIGINS=http://foster-heirs.test

# Cloudinary — stores course images and PDF materials for the imported
# course-admin backend (App\Services\CloudinaryService). Get these from
# your Cloudinary dashboard (Settings > API Keys) at cloudinary.com.
# Course image/material uploads will error until these are filled in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
